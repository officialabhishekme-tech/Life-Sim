rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && (!('gender' in data) || data.gender in ['male', 'female'])
        && data.hunger is number && data.hunger >= 0 && data.hunger <= 100
        && data.hydration is number && data.hydration >= 0 && data.hydration <= 100
        && data.fatigue is number && data.fatigue >= 0 && data.fatigue <= 100
        && data.health is number && data.health >= 0 && data.health <= 100;
    }

    function isValidBankAccount(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.customerId is string && data.customerId.size() <= 64
        && data.accountNumber is string && data.accountNumber.size() <= 64
        && data.balance is number && data.balance >= 0
        && data.cardNumber is string && data.cardNumber.size() <= 32;
    }

    function isValidSimProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.phoneNumber is string && data.phoneNumber.size() <= 32
        && data.carrier is string && data.carrier.size() <= 64
        && data.isActivated is bool;
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.amount is number && data.amount > 0
        && data.type is string && data.type.size() <= 32
        && data.category is string && data.category.size() <= 64
        && data.description is string && data.description.size() <= 200
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.balanceAfter is number;
    }

    function isValidP2PTransfer(data) {
      return data.senderId is string && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() <= 100
        && data.recipientTarget is string && data.recipientTarget.size() <= 100
        && data.amount is number && data.amount > 0
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.status is string && data.status.size() <= 32;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // Bank account subcollection
      match /bankAccounts/{accountId} {
        allow get: if isOwner(userId) && isValidId(accountId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidBankAccount(incoming());
        allow update: if isOwner(userId) && isValidId(accountId) && isValidBankAccount(incoming());
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // SIM profile subcollection
      match /simProfiles/{simId} {
        allow get: if isOwner(userId) && isValidId(simId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(simId) && isValidSimProfile(incoming());
        allow update: if isOwner(userId) && isValidId(simId) && isValidSimProfile(incoming());
        allow delete: if isOwner(userId) && isValidId(simId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if false; // Transactions are immutable audit trails
        allow delete: if false;
      }
    }

    // Peer-to-peer transfers collection
    match /p2pTransfers/{transferId} {
      allow get: if isSignedIn() && isValidId(transferId) && (resource.data.senderId == request.auth.uid || resource.data.recipientTarget == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientTarget == request.auth.uid);
      allow create: if isSignedIn() && isValidId(transferId) && isValidP2PTransfer(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
